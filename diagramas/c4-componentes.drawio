&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 10px 20px 10px;text-align:left;vertical-align:top;color:#7F7F7F;&quot;&gt;BastionGame lleva el game loop; Navigator y ScreenRegistry manejan la pila de pantallas.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Carlito;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCarlito%3A400%2C400i%2C700%2C700i;fontSize=11;fontColor=#000000;overflow=fill;fillColor=#FFFFFF;gradientColor=#ECEAEA;gradientDirection=south;strokeColor=#9B7D72;strokeWidth=1;shadow=1;verticalAlign=top;spacing=0;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="cli-1"><mxGeometry x="60" y="335" width="250" height="185" as="geometry"/></mxCell><mxCell id="cli-i11" value="" style="shape=module;jettyWidth=6;jettyHeight=3;html=1;fillColor=#FFFFFF;strokeColor=#7F675D;strokeWidth=1;" vertex="1" parent="cli-C_NAV"><mxGeometry x="224" y="9" width="15" height="19" as="geometry"/></mxCell><mxCell id="cli-i12" value="" style="ellipse;html=1;fillColor=none;strokeColor=#7F675D;strokeWidth=1.5;" vertex="1" parent="cli-C_NAV"><mxGeometry x="214" y="170" width="12" height="7" as="geometry"/></mxCell><mxCell id="cli-i13" value="" style="ellipse;html=1;fillColor=none;strokeColor=#7F675D;strokeWidth=1.5;" vertex="1" parent="cli-C_NAV"><mxGeometry x="229" y="170" width="12" height="7" as="geometry"/></mxCell><mxCell id="cli-i14" value="" style="line;html=1;strokeColor=#7F675D;strokeWidth=1.5;" vertex="1" parent="cli-C_NAV"><mxGeometry x="225" y="173" width="5" height="1" as="geometry"/></mxCell><mxCell id="cli-C_SCREENS" value="&lt;table style=&quot;width:100%;height:100%;border-collapse:collapse;font-family:Carlito,Calibri,&#x27;Segoe UI&#x27;,sans-serif;font-size:11px;line-height:1.25;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;height:1px;padding:7px 30px 7px 30px;text-align:center;border-bottom:1px solid #9B7D72;&quot;&gt;«Component»&lt;br&gt;&lt;b&gt;Pantallas (XScreen)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:1px;padding:4px 8px 6px 8px;text-align:left;border-bottom:1px solid #9B7D72;&quot;&gt;&lt;div style=&quot;text-align:center;&quot;&gt;&lt;i&gt;tags&lt;/i&gt;&lt;/div&gt;Technology = MonoGame DesktopGL&lt;br&gt;Type = Vista MVP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 10px 20px 10px;text-align:left;vertical-align:top;color:#7F7F7F;&quot;&gt;LoginScreen, WaitingRoomScreen, MatchScreen…: dibujan, leen teclado y mouse, y revisan en Update si terminó cada llamada.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Carlito;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCarlito%3A400%2C400i%2C700%2C700i;fontSize=11;fontColor=#000000;overflow=fill;fillColor=#FFFFFF;gradientColor=#ECEAEA;gradientDirection=south;strokeColor=#9B7D72;strokeWidth=1;shadow=1;verticalAlign=top;spacing=0;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="cli-1"><mxGeometry x="380" y="335" width="250" height="185" as="geometry"/></mxCell><mxCell id="cli-i15" value="" style="shape=module;jettyWidth=6;jettyHeight=3;html=1;fillColor=#FFFFFF;strokeColor=#7F675D;strokeWidth=1;" vertex="1" parent="cli-C_SCREENS"><mxGeometry x="224" y="9" width="15" height="19" as="geometry"/></mxCell><mxCell id="cli-i16" value="" style="ellipse;html=1;fillColor=none;strokeColor=#7F675D;strokeWidth=1.5;" vertex="1" parent="cli-C_SCREENS"><mxGeometry x="214" y="170" width="12" height="7" as="geometry"/></mxCell><mxCell id="cli-i17" value="" style="ellipse;html=1;fillColor=none;strokeColor=#7F675D;strokeWidth=1.5;" vertex="1" parent="cli-C_SCREENS"><mxGeometry x="229" y="170" width="12" height="7" as="geometry"/></mxCell><mxCell id="cli-i18" value="" style="line;html=1;strokeColor=#7F675D;strokeWidth=1.5;" vertex="1" parent="cli-C_SCREENS"><mxGeometry x="225" y="173" width="5" height="1" as="geometry"/></mxCell><mxCell id="cli-C_CONTROLS" value="&lt;table style=&quot;width:100%;height:100%;borde