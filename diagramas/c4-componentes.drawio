. Todo lo que sale del proceso va detrás de una interfaz. Nada espera con await en la pantalla." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Carlito;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCarlito%3A400%2C400i%2C700%2C700i;fontSize=11;fontColor=#000000;fillColor=#FFFFE1;strokeColor=#A3A3A3;align=left;verticalAlign=top;spacing=8;shadow=1;" vertex="1" parent="cli-1"><mxGeometry x="920" y="60" width="420" height="100" as="geometry"/></mxCell><mxCell id="cli-e64" value="Juega con teclado y mouse&lt;br&gt;«Synchronous»" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Carlito;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCarlito%3A400%2C400i%2C700%2C700i;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.14;exitY=1;exitDx=0;exitDy=0;entryX=0.86;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="cli-1" source="cli-PERSON" target="cli-C_SCREENS"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cli-e65" value="Dibuja la activa" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Carlito;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCarlito%3A400%2C400i%2C700%2C700i;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="cli-1" source="cli-C_NAV" target="cli-C_SCREENS"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cli-e66" value="Se arma con" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Carlito;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCarlito%3A400%2C400i%2C700%2C700i;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="cli-1" source="cli-C_SCREENS" target="cli-C_CONTROLS"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cli-e67" value="Delegan las acciones" styl